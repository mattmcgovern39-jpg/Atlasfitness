# Copy this file to .env.local — .env.local is git-ignored and never leaves your machine.
# This app has no required external services: it stores everything in a local
# SQLite file and dials via your device's own phone/softphone (tel: links).

# Path to the local SQLite database file (relative to project root).
DIALER_DB_PATH=./data/dialer.db

# Default cold-calling window, used to warn you before dialing outside
# generally-accepted, TCPA-aligned hours for the LEAD's local time zone.
# 24h format, local time.
CALLING_HOURS_START=08:00
CALLING_HOURS_END=21:00
