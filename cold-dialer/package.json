{
  "name": "cold-dialer",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first cold calling power dialer with CSV lead import and full call-activity tracking.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed:sample": "tsx scripts/generate-sample-csv.ts",
    "db:seed:demo": "tsx scripts/seed-demo-data.ts",
    "db:reset": "node -e \"require('fs').rmSync('./data',{recursive:true,force:true});console.log('Local database wiped.')\"",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "date-fns": "^3.6.0",
    "next": "^16.3.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
